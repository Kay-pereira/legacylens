# Copy to .env and fill in. Never commit real keys.

# Fact store and generated docs
LEGACYLENS_DB=.legacylens/legacylens.db
LEGACYLENS_OUT=.legacylens/site

# LLM provider: none | openai | ollama | openai-compatible
LEGACYLENS_PROVIDER=none
LEGACYLENS_MODEL=gpt-4o-mini
# LEGACYLENS_BASE_URL=https://api.openai.com/v1
# LEGACYLENS_API_KEY=
